{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pnfc-toolkit",
  "version": "0.1.0",
  "identifier": "com.albert.pnfc-toolkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pnfc-toolkit",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "deb", "appimage", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzRjFGNTEzRURBOTBBRTUKUldUbENxbnRFL1h4a3ljQzBDVkxUOXE5U0J0bENyU3Z5K3FWcnZLNXhBSTNXZFZMVVpaNEZLZHAK",
      "endpoints": [
        "https://github.com/wxul/pnfc-toolkit/releases/latest/download/latest.json"
      ]
    }
  }
}
